rules_version = '2';

// FATE VOTE SYSTEM — Firestore security rules
// Paste these in: Firebase console > Firestore Database > Rules > Publish.
// Requires: Anonymous sign-in enabled (Authentication > Sign-in method > Anonymous).
service cloud.firestore {
  match /databases/{database}/documents {

    // The active poll question. EDITED ONLY FROM THE FIREBASE CONSOLE
    // (create/change the "current" doc to ask your own question - see
    // FIREBASE-VOTES-SETUP.txt). Clients can read it, and may CREATE it
    // exactly once (that is how the site owner seeds the first poll
    // remotely); it can never be changed or deleted by visitors.
    match /polls/current {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Ballots: one doc per player per poll round, id = <uid>__<round>.
    // A player creates their ballot once per round, and may MOVE it (change
    // only the choice field) when re-confirming in a later session. Nobody
    // can edit anyone else's ballot, change its round, or delete anything.
    match /polls/{pollId}/voters/{ballotId} {
      allow read: if true;
      allow create: if request.auth != null
                    && ballotId.split('__')[0] == request.auth.uid
                    && request.resource.data.keys().hasOnly(['choice', 'round', 'at'])
                    && request.resource.data.choice is int
                    && request.resource.data.choice >= 0
                    && request.resource.data.choice < 32
                    && request.resource.data.round is string;
      allow update: if request.auth != null
                    && ballotId.split('__')[0] == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['choice'])
                    && request.resource.data.choice is int
                    && request.resource.data.choice >= 0
                    && request.resource.data.choice < 32
                    && resource.data.round == request.resource.data.round;
      allow delete: if false;
    }

    // Everything else in this database is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
